# ============================================================
# Pedidos360 — Ejemplo de archivo de configuración .env
# ------------------------------------------------------------
# Copia este archivo como `.env` en la raíz del proyecto:
#     copy .env.example .env
# ============================================================

# --- Autenticación (Microsoft Entra ID) ---------------------
# false => login real con Microsoft Entra ID (producción).
# true  => PRUEBA LOCAL: permite navegar y probar sin Azure.
AUTH_BYPASS=false

# --- Build del frontend -------------------------------------
# docker     => usa environment.docker.ts (puertos directos localhost para demo local).
# production => usa environment.prod.ts (puertos directos de EC2 para despliegue en la nube).
NG_BUILD_CONFIG=docker

# --- Azure Entra ID Issuer URI ------------------------------
AZURE_ISSUER_URI=https://login.microsoftonline.com/9150f81f-b0fc-436d-998d-dcb5cf883d2e/v2.0

# --- Correo SMTP (ms-email) ---------------------------------
# Para envío real mediante Gmail SMTP:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pedidos360.cl

# --- RabbitMQ ------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Kafka (KRaft Brokers) ----------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- DynamoDB NoSQL (+2 Puntos Extra) -----------------------
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
AWS_REGION=us-east-1

# --- Siembra automática de catálogo inicial -----------------
CATALOGO_SEED=true
